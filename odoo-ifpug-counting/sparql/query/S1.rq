# S1 - UFP and number of rows by counting side (declarative / parameterized).
PREFIX : <http://example.org/odoo-ifpug#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?countingSide (ROUND(SUM(?w)) AS ?UFP) (COUNT(*) AS ?rows)
WHERE { GRAPH <urn:functions> { ?fn :weight ?w ; :countingSide ?countingSide } }
GROUP BY ?countingSide
